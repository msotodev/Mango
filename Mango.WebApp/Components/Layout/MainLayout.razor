@inherits LayoutComponentBase

<div class="page">
	<div class="sidebar">
		<NavMenu />
	</div>

	<main>
		<article class="content p-3">
			<AuthorizeView>
				<Authorized>
					@Body
				</Authorized>
				<NotAuthorized>
					<h1>Not Authorized</h1>
				</NotAuthorized>
			</AuthorizeView>
		</article>

		<MudThemeProvider />
		<MudPopoverProvider />
		<MudDialogProvider />
		<MudSnackbarProvider />
	</main>
</div>

<div id="blazor-error-ui">
	An unhandled error has occurred.
	<a href="" class="reload">Reload</a>
	<a class="dismiss">🗙</a>
</div>